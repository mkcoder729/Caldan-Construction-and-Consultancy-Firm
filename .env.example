# =====================================================================
# CALDAN CONSTRUCTION - PRODUCTION ENVIRONMENT TEMPLATE
# Copy the keys you need into Railway's Variables tab.
# NEVER commit a populated .env to version control.
# =====================================================================

# ----- Django core -----
SECRET_KEY=replace-with-railway-generated-secret
DEBUG=False
ALLOWED_HOSTS=caldanconstruction.com,www.caldanconstruction.com,<railway-domain>.up.railway.app
ENVIRONMENT=production
BASE_URL=https://caldanconstruction.com
SITE_URL=https://caldanconstruction.com

# ----- Database (MySQL) -----
# Use the Railway MySQL add-on values, OR a managed MySQL provider.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306

# ----- Redis (cache + Celery broker) -----
REDIS_URL=redis://default:<password>@<host>:<port>
REDIS_CACHE_TIMEOUT=300
CACHE_FALLBACK_TO_DB=True
CACHE_FALLBACK_TIMEOUT=60

# ----- Paystack -----
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_PUBLIC_KEY=pk_live_xxx
PAYSTACK_LIVE=True
PAYSTACK_CALLBACK_URL=https://caldanconstruction.com/shop/payment/verify/
PAYSTACK_WEBHOOK_URL=https://caldanconstruction.com/shop/payment/webhook/
PAYSTACK_WEBHOOK_IP_WHITELIST=52.31.139.75,52.49.173.169,52.214.14.220

# ----- M-Pesa STK Push -----
MPESA_STK_PUSH_ENABLED=True
MPESA_BUSINESS_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://caldanconstruction.com/shop/payment/mpesa-callback/
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_ENVIRONMENT=production

# ----- Email (Resend) -----
RESEND_API_KEY=re_xxx
SEND_REAL_EMAILS=True
DEFAULT_FROM_EMAIL=Caldan Construction <noreply@caldanconstruction.com>
ADMIN_EMAIL=info.caldanconstruction@gmail.com

# ----- SMS (Africa's Talking) -----
SMS_PROVIDER=africastalking
SEND_REAL_SMS=True
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SANDBOX=False

# ----- Cloudinary -----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- Celery -----
CELERY_BROKER_URL=redis://default:<password>@<host>:<port>
CELERY_RESULT_BACKEND=redis://default:<password>@<host>:<port>

# ----- Security headers -----
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://caldanconstruction.com,https://www.caldanconstruction.com
CORS_ALLOWED_ORIGINS=https://caldanconstruction.com,https://www.caldanconstruction.com

# ----- Sentry (optional) -----
SENTRY_DSN=

# ----- Logging -----
DJANGO_LOG_LEVEL=INFO
LOG_LEVEL=INFO
