<style>
/* ================================================================
   CALDAN CONSTRUCTION - DASHBOARD THEME SYSTEM
   Light Mode = Caldan Light Blue + Cream
   Dark Mode = Deep Navy
   ================================================================ */

/* ================================================================
   1. LIGHT MODE (Caldan Light + Cream)
   ================================================================ */
:root,
[data-theme="light"] {
    /* Brand - DO NOT CHANGE */
    --brand-blue: #0B66C3;
    --brand-blue-hover: #0A55A8;
    --brand-blue-deep: #0F1F3A;
    --brand-blue-mid: #1A2E5C;
    --brand-gold: #D4AF37;
    --brand-gold-hover: #E8C84A;
    --brand-gold-deep: #B8932A;
    --brand-navy: #0B172A;

    /* Light Mode Surfaces - Caldan Light Blue + Cream */
    --bg-canvas: #F0F4F9;
    --bg-card: #FFFFFF;
    --bg-card-hover: #F5F8FC;
    --bg-secondary: #EEF2F7;
    --bg-input: #F5F8FC;
    --bg-topbar: rgba(255, 255, 255, 0.82);
    --bg-topbar-scrolled: rgba(240, 244, 249, 0.95);
    --bg-sidebar: linear-gradient(180deg, #D6E4F0 0%, #E8EFF6 100%);
    --bg-sidebar-hover: rgba(11, 102, 195, 0.08);
    --bg-sidebar-active: var(--brand-gold);
    --bg-profile-banner: rgba(11, 102, 195, 0.06);

    /* Semantic (used by stat cards, status badges, role badges, etc.) */
    --sem-success: #27AE60;
    --sem-warning: #F39C12;
    --sem-danger:  #B9342B;
    --sem-info:    #2980B9;

    /* Text */
    --text-primary: #0F172A;
    --text-secondary: #475569;
    --text-tertiary: #94A3B8;
    --text-inverse: #FFFFFF;
    --text-sidebar: #1A3A5C;
    --text-sidebar-active: #0B172A;
    --text-sidebar-hover: #0B66C3;

    /* Borders */
    --border-subtle: #E2E8F0;
    --border-default: #CBD5E1;
    --border-strong: #94A3B8;
    --border-sidebar: rgba(11, 102, 195, 0.10);
    --border-sidebar-hover: rgba(11, 102, 195, 0.20);

    /* Shadows */
    --shadow-xs: 0 1px 2px rgba(11, 102, 195, 0.04);
    --shadow-sm: 0 1px 2px rgba(11, 102, 195, 0.05), 0 2px 4px rgba(11, 102, 195, 0.04);
    --shadow-md: 0 1px 2px rgba(11, 102, 195, 0.06), 0 8px 24px -12px rgba(11, 102, 195, 0.10);
    --shadow-lg: 0 4px 6px -2px rgba(11, 102, 195, 0.06), 0 16px 32px -12px rgba(11, 102, 195, 0.14);
    --shadow-xl: 0 8px 12px -4px rgba(11, 102, 195, 0.08), 0 24px 48px -16px rgba(11, 102, 195, 0.18);
    --shadow-gold: 0 12px 28px -8px rgba(212, 175, 55, 0.35);
    --shadow-blue: 0 12px 28px -8px rgba(11, 102, 195, 0.25);

    /* Layout */
    --sidebar-width: 280px;
    --topbar-height: 72px;
    --topbar-height-sm: 60px;
    --content-max: 1440px;

    /* Radius */
    --r-xs: 6px;
    --r-sm: 8px;
    --r-md: 10px;
    --r-lg: 14px;
    --r-xl: 20px;
    --r-pill: 9999px;

    /* Motion */
    --ease-spring: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);
    --t-fast: 140ms;
    --t-base: 220ms;
    --t-slow: 320ms;
}

/* ================================================================
   2. DARK MODE (Deep Navy)
   ================================================================ */
[data-theme="dark"] {
    --bg-canvas: #0B1220;
    --bg-card: #111A2E;
    --bg-card-hover: #16213D;
    --bg-secondary: #0F1729;
    --bg-input: #16213D;
    --bg-topbar: rgba(11, 18, 32, 0.82);
    --bg-topbar-scrolled: rgba(11, 18, 32, 0.95);
    --bg-sidebar: linear-gradient(180deg, #060B17 0%, #0B1227 100%);
    --bg-sidebar-hover: rgba(255, 255, 255, 0.06);
    --bg-profile-banner: rgba(255, 255, 255, 0.04);

    --text-primary: #F1F5F9;
    --text-secondary: #94A3B8;
    --text-tertiary: #64748B;
    --text-sidebar: #94A3B8;
    --text-sidebar-active: #0B172A;
    --text-sidebar-hover: #FFFFFF;

    --border-subtle: #1E293B;
    --border-default: #273549;
    --border-strong: #334155;
    --border-sidebar: rgba(255, 255, 255, 0.06);

    /* Semantic (slightly brighter for dark surfaces) */
    --sem-success: #2ECC71;
    --sem-warning: #F1C40F;
    --sem-danger:  #E74C3C;
    --sem-info:    #3498DB;

    --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.4);
    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4), 0 2px 4px rgba(0, 0, 0, 0.4);
    --shadow-md: 0 1px 2px rgba(0, 0, 0, 0.5), 0 8px 24px -12px rgba(0, 0, 0, 0.6);
    --shadow-lg: 0 4px 6px -2px rgba(0, 0, 0, 0.5), 0 16px 32px -12px rgba(0, 0, 0, 0.7);
    --shadow-xl: 0 8px 12px -4px rgba(0, 0, 0, 0.5), 0 24px 48px -16px rgba(0, 0, 0, 0.8);
    --shadow-gold: 0 12px 28px -8px rgba(212, 175, 55, 0.25);
    --shadow-blue: 0 12px 28px -8px rgba(11, 102, 195, 0.20);
}

/* ================================================================
   3. DEVICE DEFAULT
   ================================================================ */
@media (prefers-color-scheme: dark) {
    [data-theme="device"] {
        --bg-canvas: #0B1220;
        --bg-card: #111A2E;
        --bg-card-hover: #16213D;
        --bg-secondary: #0F1729;
        --bg-input: #16213D;
        --bg-topbar: rgba(11, 18, 32, 0.82);
        --bg-topbar-scrolled: rgba(11, 18, 32, 0.95);
        --bg-sidebar: linear-gradient(180deg, #060B17 0%, #0B1227 100%);
        --text-primary: #F1F5F9;
        --text-secondary: #94A3B8;
        --text-tertiary: #64748B;
        --text-sidebar: #94A3B8;
        --text-sidebar-active: #0B172A;
        --border-subtle: #1E293B;
        --border-default: #273549;
        --sem-success: #2ECC71;
        --sem-warning: #F1C40F;
        --sem-danger:  #E74C3C;
        --sem-info:    #3498DB;
        --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.4);
        --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4), 0 2px 4px rgba(0, 0, 0, 0.4);
        --shadow-md: 0 1px 2px rgba(0, 0, 0, 0.5), 0 8px 24px -12px rgba(0, 0, 0, 0.6);
        --shadow-lg: 0 4px 6px -2px rgba(0, 0, 0, 0.5), 0 16px 32px -12px rgba(0, 0, 0, 0.7);
        --shadow-xl: 0 8px 12px -4px rgba(0, 0, 0, 0.5), 0 24px 48px -16px rgba(0, 0, 0, 0.8);
    }
}

/* ================================================================
   4. REDUCED MOTION
   ================================================================ */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transform: none !important;
    }
}

/* ================================================================
   5. BASE
   ================================================================ */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    font-size: 16px;
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg-canvas);
    color: var(--text-primary);
    line-height: 1.6;
    transition: background var(--t-base) var(--ease-standard),
                color var(--t-base) var(--ease-standard);
    overflow-x: hidden;
}

::-webkit-scrollbar {
    width: 6px;
    height: 6px;
}
::-webkit-scrollbar-track {
    background: var(--bg-secondary);
}
::-webkit-scrollbar-thumb {
    background: var(--brand-gold);
    border-radius: var(--r-pill);
}
::-webkit-scrollbar-thumb:hover {
    background: var(--brand-gold-hover);
}

/* ================================================================
   6. SIDEBAR
   ================================================================ */
.sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-width);
    height: 100vh;
    background: var(--bg-sidebar);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    transition: transform var(--t-base) var(--ease-standard),
                background var(--t-base) var(--ease-standard);
    overflow: hidden;
    border-right: 1px solid var(--border-sidebar);
    box-shadow: 0 0 40px rgba(11, 102, 195, 0.06);
}

.sidebar-header {
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border-sidebar);
    flex-shrink: 0;
    height: var(--topbar-height);
    position: relative;
}

.sidebar-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.sidebar-logo {
    height: 56px;
    width: auto;
    max-width: 180px;
    object-fit: contain;
    object-position: center;
    flex-shrink: 0;
    transition: opacity var(--t-base) var(--ease-standard);
}

.sidebar-logo-light { display: block; }
.sidebar-logo-dark { display: none; }
[data-theme="dark"] .sidebar-logo-light { display: none; }
[data-theme="dark"] .sidebar-logo-dark { display: block; }

.sidebar-close {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    display: none;
    background: none;
    border: none;
    color: var(--text-sidebar);
    font-size: 1.2rem;
    cursor: pointer;
    padding: 4px;
    transition: color var(--t-fast) var(--ease-standard);
}
.sidebar-close:hover { color: var(--brand-gold); }

.sidebar-search {
    position: relative;
    flex-shrink: 0;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-subtle);
}

.sidebar-search__icon {
    position: absolute;
    left: 26px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-tertiary);
    font-size: 0.85rem;
    pointer-events: none;
    transition: color var(--t-fast) var(--ease-standard);
}

.sidebar-search__input {
    width: 100%;
    height: 38px;
    padding: 0 36px 0 36px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-pill);
    background: var(--bg-canvas);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.85rem;
    transition: border-color var(--t-fast) var(--ease-standard),
                box-shadow var(--t-fast) var(--ease-standard),
                background var(--t-fast) var(--ease-standard);
}
.sidebar-search__input::-webkit-search-cancel-button { display: none; }
.sidebar-search__input::placeholder { color: var(--text-tertiary); }
.sidebar-search__input:hover {
    border-color: var(--border-default);
}
.sidebar-search__input:focus {
    outline: none;
    border-color: var(--brand-gold);
    box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.16);
    background: var(--bg-card);
}
.sidebar-search__input:focus ~ .sidebar-search__icon,
.sidebar-search:focus-within .sidebar-search__icon { color: var(--brand-gold); }

.sidebar-search__clear {
    position: absolute;
    right: 22px;
    top: 50%;
    transform: translateY(-50%);
    width: 24px; height: 24px;
    border: none;
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--text-tertiary);
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    transition: all var(--t-fast) var(--ease-standard);
}
.sidebar-search__clear.visible { display: inline-flex; }
.sidebar-search__clear:hover {
    background: var(--bg-sidebar-hover);
    color: var(--text-primary);
}

.sidebar-nav {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 8px 0 16px;
    scrollbar-gutter: stable;
    scroll-behavior: smooth;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 22px, #000 calc(100% - 22px), transparent 100%);
            mask-image: linear-gradient(to bottom, transparent 0, #000 22px, #000 calc(100% - 22px), transparent 100%);
}

.sidebar-nav::-webkit-scrollbar { width: 4px; }
.sidebar-nav::-webkit-scrollbar-track { background: transparent; }
.sidebar-nav::-webkit-scrollbar-thumb {
    background: rgba(212, 175, 55, 0.45);
    border-radius: var(--r-pill);
    transition: background var(--t-fast) var(--ease-standard);
}
.sidebar-nav:hover::-webkit-scrollbar-thumb,
.sidebar-nav:focus-within::-webkit-scrollbar-thumb { background: var(--brand-gold); }
.sidebar-nav { scrollbar-width: thin; scrollbar-color: rgba(212, 175, 55, 0.45) transparent; }

.sidebar-empty {
    padding: 48px 20px;
    text-align: center;
    color: var(--text-tertiary);
}
.sidebar-empty i { font-size: 1.7rem; margin-bottom: 8px; opacity: 0.6; }
.sidebar-empty p { font-size: 0.84rem; margin: 0; }

.sidebar-section {
    margin-bottom: 2px;
    padding: 0 12px;
}
.sidebar-section[hidden] { display: none; }

.sidebar-section-label {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 16px 12px 8px;
    margin-bottom: 4px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--brand-gold-deep);
    position: relative;
}

.sidebar-section-icon {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.18) 0%, rgba(212, 175, 55, 0.08) 100%);
    border: 1px solid rgba(212, 175, 55, 0.28);
    color: var(--brand-gold-deep);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    flex-shrink: 0;
    transition: transform var(--t-fast) var(--ease-standard),
                background var(--t-fast) var(--ease-standard);
}

.sidebar-section-text {
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
    min-width: 0;
}

.sidebar-section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    margin-left: 6px;
    background: linear-gradient(90deg, rgba(212, 175, 55, 0.32) 0%, rgba(212, 175, 55, 0) 100%);
}

.sidebar-subheader {
    padding: 12px 16px 6px;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--brand-gold-deep);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    border-top: 1px dashed var(--border-subtle);
}
.sidebar-subheader:first-child {
    border-top: none;
    margin-top: 2px;
}
.sidebar-subheader i {
    color: var(--brand-gold);
    font-size: 0.7rem;
    width: 14px;
    text-align: center;
}

.sidebar-items {
    list-style: none;
    padding: 0;
    margin: 0;
    interpolate-size: allow-keywords;
}
.sidebar-items[hidden],
.sidebar-item[hidden] { display: none !important; }

@media (prefers-reduced-motion: reduce) {
    .sidebar-link,
    .sidebar-link-icon { animation: none !important; transition: none !important; }
}

.sidebar-item {
    margin: 0 6px;
}

.sidebar-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    border-radius: var(--r-md);
    color: var(--text-sidebar);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: background var(--t-fast) var(--ease-standard),
                color var(--t-fast) var(--ease-standard),
                transform var(--t-fast) var(--ease-standard),
                box-shadow var(--t-fast) var(--ease-standard),
                border-color var(--t-fast) var(--ease-standard);
    cursor: pointer;
    will-change: transform;
}

.sidebar-link::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 50%;
    width: 3px;
    height: 0;
    background: var(--brand-gold);
    border-radius: 0 var(--r-xs) var(--r-xs) 0;
    transform: translateY(-50%);
    transition: height var(--t-base) var(--ease-spring),
                opacity var(--t-fast) var(--ease-standard);
    opacity: 0.55;
}

.sidebar-link:hover,
.sidebar-link:focus-visible {
    background: var(--bg-sidebar-hover);
    color: var(--text-sidebar-hover);
    transform: translateX(2px);
    outline: none;
}
.sidebar-link:hover .sidebar-link-icon,
.sidebar-link:focus-visible .sidebar-link-icon {
    transform: scale(1.08) rotate(3deg);
}
.sidebar-link:hover::before,
.sidebar-link:focus-visible::before {
    height: 60%;
    opacity: 1;
}

.sidebar-link-icon {
    width: 20px;
    text-align: center;
    font-size: 0.95rem;
    flex-shrink: 0;
    transition: transform var(--t-fast) var(--ease-standard);
}
.sidebar-link span {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.sidebar-item.active .sidebar-link {
    background: linear-gradient(135deg, var(--brand-gold) 0%, var(--brand-gold-hover) 100%);
    color: var(--text-sidebar-active);
    box-shadow: var(--shadow-gold), inset 0 1px 0 rgba(255,255,255,0.35);
    font-weight: 700;
    transform: translateX(2px);
    border: 1px solid rgba(255, 255, 255, 0.18);
}
.sidebar-item.active .sidebar-link::before {
    height: 70%;
    background: var(--brand-navy);
    opacity: 1;
    left: -6px;
    width: 4px;
    box-shadow: 0 0 8px rgba(11, 23, 42, 0.4);
}
.sidebar-item.active .sidebar-link .sidebar-link-icon {
    color: var(--brand-navy);
    transform: rotate(-4deg) scale(1.08);
}
.sidebar-item.active .sidebar-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(255,255,255,0.10), transparent 60%);
    pointer-events: none;
}

.sidebar-badge {
    background: var(--sem-danger);
    color: var(--text-inverse);
    font-size: 0.55rem;
    font-weight: 600;
    padding: 1px 8px;
    border-radius: var(--r-pill);
    flex-shrink: 0;
}

.sidebar-link:focus-visible {
    box-shadow: 0 0 0 2px rgba(212, 175, 55, 0.45);
}

.sidebar.open .sidebar-nav { -webkit-mask-image: none; mask-image: none; }

/* ================================================================
   7. SIDEBAR PROFILE BANNER - PERFECTED
   ================================================================ */
.sidebar-footer-section {
    border-top: 1px solid var(--border-sidebar);
    padding: 12px 12px 8px;
    flex-shrink: 0;
}

.profile-banner {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background: var(--bg-profile-banner);
    border: 1px solid var(--border-sidebar);
    border-radius: var(--r-lg);
    transition: background var(--t-base) var(--ease-standard),
                border-color var(--t-base) var(--ease-standard),
                transform var(--t-base) var(--ease-spring);
    position: relative;
}

.profile-banner:hover {
    border-color: rgba(212, 175, 55, 0.40);
    transform: translateY(-2px);
    background: rgba(11, 102, 195, 0.08);
}

[data-theme="dark"] .profile-banner:hover {
    background: rgba(255, 255, 255, 0.06);
}

.profile-banner-avatar {
    width: 44px;
    height: 44px;
    border-radius: var(--r-pill);
    background: linear-gradient(135deg, var(--brand-blue), var(--brand-blue-deep));
    color: var(--text-inverse);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 16px;
    flex-shrink: 0;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 0 0 2px var(--brand-gold);
}

[data-theme="light"] .profile-banner-avatar {
    background: linear-gradient(135deg, var(--brand-blue), #1A4F8A);
}

.profile-banner-info {
    min-width: 0;
    flex: 1;
}

.profile-banner-name {
    color: var(--text-sidebar);
    font-weight: 600;
    font-size: 13px;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

[data-theme="light"] .profile-banner-name {
    color: var(--text-primary);
}

[data-theme="dark"] .profile-banner-name {
    color: var(--text-inverse);
}

.profile-banner-role {
    display: inline-block;
    padding: 1px 10px;
    border-radius: var(--r-pill);
    background: rgba(212, 175, 55, 0.18);
    color: var(--brand-gold-deep);
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 2px;
}

[data-theme="light"] .profile-banner-role {
    background: rgba(212, 175, 55, 0.25);
    color: var(--brand-gold-deep);
}

[data-theme="dark"] .profile-banner-role {
    background: rgba(212, 175, 55, 0.20);
    color: var(--brand-gold);
}

.profile-banner-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    color: var(--text-tertiary);
    margin-top: 1px;
}

.profile-banner-status .status-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--r-pill);
    background: var(--sem-success);
    box-shadow: 0 0 0 3px rgba(39, 174, 96, 0.18);
    animation: statusPulse 2s ease-in-out infinite;
}

@keyframes statusPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.profile-banner-actions {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
}

.profile-banner-action {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-sm);
    color: var(--text-tertiary);
    background: transparent;
    border: none;
    cursor: pointer;
    text-decoration: none;
    font-size: 13px;
    transition: background var(--t-fast) var(--ease-spring),
